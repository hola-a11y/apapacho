# Clave que n8n debe enviar en el header X-API-Key. Obligatoria: sin ella el servicio no arranca.
# Genera una con: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# Límite de peticiones por IP (sintaxis de slowapi/limits). Opcional.
RATE_LIMIT=30/minute

# Orígenes permitidos para CORS, separados por comas. Vacío = CORS cerrado (por defecto).
# Solo hace falta si vas a llamar a la API directamente desde un navegador.
CORS_ORIGINS=

# URL pública del código fuente, devuelta en GET / (oferta de código fuente AGPL-3.0).
SOURCE_URL=https://github.com/hola-a11y/apapacho

# IPs/proxies de confianza para leer X-Forwarded-For (uvicorn). "*" si el reverse proxy
# está en la misma red interna de Docker y el puerto no está publicado al exterior.
FORWARDED_ALLOW_IPS=*
